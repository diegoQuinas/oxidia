/target
**/*.rs.bk
*.pdb

# Local server config (custom host/ZeroTier IP). Tracked template lives in
# config/server.toml.example — copy it to config/server.toml to run locally.
/config/server.toml

# Local runtime artifacts
*.db
*.db-journal
*.db-wal
*.db-shm
debug.log

# Reference clone is pulled on demand; keep it out of history
/reference/

# Large binaries (client assets / downloads)
*.zip

# Agent tooling state
.atl/

# git worktrees created for isolated milestone work
.claude/worktrees/

# Map + spawns + NPC + server data (game content, never committed)
/data/

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
